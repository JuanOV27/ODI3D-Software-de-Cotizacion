# ============================================================
# .htaccess — Sistema ODI3D
# Headers de seguridad HTTP
# ============================================================

# Activar mod_headers si está disponible
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Evitar que el navegador cachee páginas autenticadas.
    # Esto previene que el botón "atrás" muestre páginas protegidas
    # luego de cerrar sesión (ataque bfcache / historial del navegador).
    <FilesMatch "\.html$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# Bloquear acceso directo a archivos sensibles del servidor
<FilesMatch "\.(sql|log|md|json|lock|gitignore|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquear listado de directorios
Options -Indexes

# No permitir acceso a archivos ocultos (. prefixados)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
